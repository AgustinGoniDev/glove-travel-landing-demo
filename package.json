{
  "name": "glove-travel-landing-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Glove Travel landing: a scroll-driven flight over real Andes terrain, built with Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc --noEmit",
    "terrain": "python -I scripts/fetch_terrain.py",
    "photos": "python -I scripts/fetch_photos.py"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
